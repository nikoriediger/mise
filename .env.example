# Copy this file to .env.local and fill in your own values.
# Supabase dashboard -> Project Settings -> Data API (URL) / API Keys (publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# UI language: en | de
NEXT_PUBLIC_APP_LOCALE=en
# Name shown in the header and browser tab
NEXT_PUBLIC_APP_NAME=mise
# Show the public landing page at /welcome to signed-out visitors
NEXT_PUBLIC_LANDING_PAGE=true
